<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org//wiki/xacro">
    <xacro:include filename="inertial_macros.xacro"/>
    <material name ="white">
        <color rgba ="1 1 1 1"/>    
    </material>

    <material name ="orange">
        <color rgba ="0.49 0.49 0.49 1"/>
    </material>
    <material name ="yellow">
        <color rgba ="1 1 0 0.5"/>
    </material>
    <material name ="blue">
        <color rgba ="0.2 0.2 1 1"/>
    </material>

    <material name ="black">
        <color rgba ="0 0 0 1"/>
    </material>

    <material name ="red">
        <color rgba ="1 0 0 1"/>
    </material>

    <xacro:property name="chassis_length" value="0.93"/>
    <xacro:property name="chassis_width" value="0.40"/>
    <xacro:property name="chassis_height" value="0.385"/>
    <xacro:property name="chassis_mass" value="10.0"/>
    <xacro:property name="wheel_radius" value="0.165"/>
    <xacro:property name="wheel_thickness" value="0.04"/>
    <xacro:property name="wheel_mass" value="1.0"/>
    <xacro:property name="wheel_offset_x" value="0.46"/>
    <xacro:property name="caster_wheel_radius" value="0.04"/>
    <xacro:property name="caster_wheel_mass" value="0.1"/>
    <xacro:property name="caster_wheel_offset_x" value="0.37"/>
    <xacro:property name="support_radius" value="0.04"/>
    <xacro:property name="support_length" value="0.25"/>
    <xacro:property name="support_x" value="0.04"/>
    <xacro:property name="support_mass" value="0.2"/>
    <xacro:property name="friction_coefficient_castor" value="0.0001"/>
    <xacro:property name="caster_wheel_z" value="${support_length/2}"/>


    <!-- BASE_FOOTPRINT LINK -->

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint">
    </link>

        <!-- BASE LINK -->
    <link name ="base_link">
    </link>  
        <!-- CHASSIS LINK -->
    <joint name ="chassis_joint" type="fixed">
          <parent link="base_link"/>
          <child link="chassis"/>
          <origin xyz ="0 0 0"/>
    </joint>




    <link name ="chassis">
        <visual>
            <origin xyz ="0 0 ${chassis_height/2}"/>
            <geometry>
                <box size ="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name ="orange"/>
        </visual>
        <collision>
            <origin xyz ="0 0 ${chassis_height/2}"/>
            <geometry>
                <box size ="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 ${chassis_height}" rpy ="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <gazebo reference ="chassis">
        <material> Gazebo/Grey</material>
    </gazebo>



            <!-- front Bumper -->
    <joint name="front_bumper_joint" type="fixed">
        <parent link="chassis"/>
        <child link="front_bumper"/>
        <origin xyz="${chassis_length/2 + 0.20/2} 0 0"/>
    </joint>

    <link name="front_bumper">

        <visual>
            <origin xyz ="0 0 0.1925"/>
            <geometry>
                <box size="0.05
                        0.69
                        0.385"/>
            </geometry>
            <material name="yellow"/>
        </visual>

        <collision>
            <origin xyz ="0 0 0.1925"/>
            <geometry>
                <box size="0.05
                        0.69
                        0.385"/>
            </geometry>
        </collision>

    </link>




            <!-- Back Bumper -->
    <joint name="back_bumper_joint" type="fixed">
        <parent link="chassis"/>
        <child link="back_bumper"/>
        <origin xyz="${-chassis_length/2 - 0.20/2} 0 0"/>
    </joint>

    <link name="back_bumper">

        <visual>
            <origin xyz ="0 0 0.1925"/>
            <geometry>
                <box size="0.05
                        0.69
                        0.385"/>
            </geometry>
            <material name="yellow"/>
        </visual>

        <collision>
            <origin xyz ="0 0 0.1925"/>
            <geometry>
                <box size="0.05
                        0.69
                        0.385"/>
            </geometry>
        </collision>

    </link>



            <!-- left Bumper -->
    <joint name="left_bumper_joint" type="fixed">
        <parent link="chassis"/>
        <child link="left_bumper"/>
        <origin xyz="0 ${chassis_width/2 + 0.29/2} 0"/>
    </joint>

    <link name="left_bumper">

        <visual>
            <origin xyz ="0 0 0.1925"/>
            <geometry>
                <box size="1
                        0.05
                        0.385"/>
            </geometry>
            <material name="yellow"/>
        </visual>

        <collision>
            <origin xyz ="0 0 0.1925"/>
            <geometry>
                <box size="1
                        0.05
                        0.385"/>
            </geometry>
        </collision>

    </link>


    <!-- RIght Bumper -->
    <joint name="right_bumper_joint" type="fixed">
        <parent link="chassis"/>
        <child link="right_bumper"/>
        <origin xyz="0 ${-chassis_width/2 - 0.29/2} 0"/>
    </joint>

    <link name="right_bumper">

        <visual>
            <origin xyz ="0 0 0.1925"/>
            <geometry>
                <box size="1
                        0.05
                        0.385"/>
            </geometry>
            <material name="yellow"/>
        </visual>

        <collision>
            <origin xyz ="0 0 0.1925"/>
            <geometry>
                <box size="1
                        0.05
                        0.385"/>
            </geometry>
        </collision>

    </link>




            <!-- LEFT WHEEL LINK -->
    <joint name ="left_wheel_joint" type ="continuous">
        <parent link="chassis"/>
        <child link ="left_wheel"/>
        <origin xyz ="0 ${wheel_offset_x/2} 0" rpy="-${pi/2} 0 0"/>
        <axis xyz ="0 0 1"/>
    </joint>

    <link name ="left_wheel">
        <visual>
            <origin xyz ="0 -0.0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length ="${wheel_thickness}"/>   ##
            </geometry>
            <material name ="black"/>
        </visual>
        <collision>
            <origin xyz ="0 -0.165 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length ="${wheel_thickness}"/>    
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius ="${wheel_radius}">   
            <origin xyz ="0 0 0" rpy =" 0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference ="left_wheel">
        <material> Gazebo/Black</material>
    </gazebo>

            <!-- RIGHT WHEEL LINK -->
    <joint name ="right_wheel_joint" type ="continuous">
        <parent link="chassis"/>
        <child link ="right_wheel"/>
        <origin xyz ="0 ${-wheel_offset_x/2} 0" rpy="-${pi/2} 0 0"/>
        <axis xyz ="0 0 1"/>
    </joint>
    
    <link name ="right_wheel">
        <visual>
            <origin xyz ="0 -0.0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length ="${wheel_thickness}"/>
            </geometry>
            <material name ="black"/>
        </visual>
        <collision>
            <origin xyz ="0 -0.165 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length ="${wheel_thickness}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius ="${wheel_radius}">
            <origin xyz ="0 0 0" rpy =" 0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference ="right_wheel">
        <material> Gazebo/Black</material>
    </gazebo>


        

    
    

    <!-- GPS SENSOR LINK -->
    <joint name="gps_joint" type="fixed">
        <parent link="chassis"/>
        <child link="gps_link"/>
        <!-- Mounted near the front/center, clear of obstacles -->
        <origin xyz="0.40 0.0 ${chassis_height+0.03}" rpy="0 0 0"/>
    </joint>

    <link name="gps_link">
        <visual>
            <geometry>
                <cylinder radius="0.04" length="0.06"/> <!-- Standard puck style visual -->
            </geometry>
            <material name="white"/>
        </visual>
    </link>

</robot>
